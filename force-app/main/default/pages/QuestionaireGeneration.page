<apex:page renderAs="{!IF(toogleJSONRender, 'pdf', 'html')}" showHeader="false" standardController="Matter__c" extensions="QuestionaireGenCtrlExt" showQuickActionVfHeader="true">
    <body style="font-family: Helvetica, Sans-Serif; font-size: 10px;">
        <apex:outputPanel rendered="{!!toogleJSONRender}">
            <div class="slds-notify_container slds-is-relative">
                <div class="slds-notify slds-notify_toast slds-theme_warning" role="status">
                    <span class="slds-assistive-text">warning</span>
                    <span class="slds-icon_container slds-icon-utility-warning slds-m-right_small slds-no-flex slds-align-top" title="Description of icon when needed">
                    <svg class="slds-icon slds-icon_small" aria-hidden="true">
                        <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="/apexpages/slds/latest/assets/icons/utility-sprite/svg/symbols.svg#warning"></use>
                    </svg>
                    </span>
                    <div class="slds-notify__content">
                    <h2 class="slds-text-heading_small ">{!dynamicMessage}</h2>
                    </div>
                    <div class="slds-notify__close">
                    </div>
                </div>
            </div>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!toogleJSONRender}">
            <table style="width: 100%;">
                <tbody>
                    <tr>
                        <td style="width: 50%;"><h1 style="font-size: 18px;">
                            <apex:outputText escape="false" value="{!title}"/></h1>
                        </td>
                        <td style="text-align: right; width: 50%;"><h1>
                            <apex:outputText escape="false" value="{!clientName}"/></h1>
                        </td>
                    </tr>
                </tbody>
            </table>
            <apex:repeat value="{!sections}" var="section" rendered="{!toogleJSONRender}">
                <table cellpadding="5px" border="1px" style="page-break-inside: avoid; border-color: #abc3d7; width: 100%; border-collapse: collapse;">
                    <tbody style="page-break-inside: avoid;">
                        <tr style="page-break-inside: avoid;"> 
                            <th colspan="2" style="page-break-inside: avoid; background-color: #00a5ed; color: white; font-weight: bold; font-size: 12px; text-align: center;">
                                <apex:outputText escape="false" value="{!section.sectionTitle}"/>
                            </th>
                        </tr>
                        <apex:variable var="rowIndex" value="{!0}"/>
                        <apex:repeat value="{!section.fields}" var="field" rendered="{!IF(section.showLabels, true, false)}">
                            <tr style="page-break-inside: avoid; background-color: {!IF(MOD(rowIndex, 2) == 0, '#ffffff', '#f5f5f5')};">
                                <td style="page-break-inside: avoid; font-weight: bold; width: 50%; font-size: 10px;">
                                    <apex:outputText escape="false" value="{!field.label}"/>
                                </td>
                                <td style="page-break-inside: avoid; width: 50%; font-size: 10px;">
                                    <apex:outputText escape="false" value="{!field.value}"/>
                                </td>
                            </tr>
                            <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                        </apex:repeat>
                        <apex:repeat value="{!section.fields}" var="field" rendered="{!IF(section.showLabels, false, true)}">
                            <tr style="page-break-inside: avoid; background-color: {!IF(MOD(rowIndex, 2) == 0, '#ffffff', '#f5f5f5')};">
                                <td colspan="2" style="page-break-inside: avoid; width: 100%; font-size: 10px;">
                                    <apex:outputText escape="false" value="{!field.value}"/>
                                </td>
                            </tr>
                            <apex:variable var="rowIndex" value="{!rowIndex + 1}"/>
                        </apex:repeat>
                    </tbody>
                </table>
                <br/>
            </apex:repeat>
        </apex:outputPanel>
    </body>
</apex:page>